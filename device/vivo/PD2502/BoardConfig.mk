# SPDX-License-Identifier: Apache-2.0
# vivo PD2502 (MT6993 / Dimensity 9400) - fox_16.0
# 基线：OFRP_device_xiaomi_dash (fox_16.0)，仅改平台/偏移/分区大小/面板参数
DEVICE_PATH := device/vivo/PD2502

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv9-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := generic

# Platform
TARGET_BOARD_PLATFORM := mt6993
TARGET_BOOTLOADER_BOARD_NAME := mt6993
TARGET_NO_BOOTLOADER := true
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_ODM := odm

# Vendor boot
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_PAGESIZE := 4096
BOARD_MKBOOTIMG_ARGS += --header_version 4 --kernel_offset 0x80000000 --ramdisk_offset 0xA3800000
BOARD_MKBOOTIMG_ARGS += --tags_offset 0x87c80000 --dtb_offset 0x87c80000 --board ""
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_PREBUILT_DTBIMAGE_DIR := $(DEVICE_PATH)/prebuilt/dtb
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 134217728
BOARD_FLASH_BLOCK_SIZE := 262144
TARGET_NO_KERNEL := true
TARGET_NO_RECOVERY := true
BOARD_USES_GENERIC_KERNEL_IMAGE := true
BOARD_BOOT_HEADER_VERSION := 4
BOARD_AVB_ENABLE := true

# Filesystems
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
BOARD_ODMIMAGE_FILE_SYSTEM_TYPE := ext4

# Recovery
TW_BRIGHTNESS_PATH := "/sys/class/leds/lcd-backlight/brightness"
TW_MAX_BRIGHTNESS := 14064
TW_DEFAULT_BRIGHTNESS := 8192
TW_THEME := portrait_hdpi
TW_EXCLUDE_DEFAULT_USB_INIT := true
TW_INCLUDE_FASTBOOTD := true
TW_FRAMERATE := 120
TW_DEVICE_VERSION := PD2502

# Panel: 1216x2640（OF 主题基准 1080x1920）
OF_SCREEN_H := 2347
OF_STATUS_H := 122
OF_STATUS_INDENT_LEFT := 68
OF_STATUS_INDENT_RIGHT := 68
OF_CLOCK_POS := 1
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888

# Encryption
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
TW_USE_FSCRYPT_POLICY := 2
OF_USE_DMCTL := 1

# Version defaults
PLATFORM_VERSION := 99.87.36
PLATFORM_VERSION_LAST_STABLE := $(PLATFORM_VERSION)
PLATFORM_SECURITY_PATCH := 2099-12-31
VENDOR_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)
BOOT_SECURITY_PATCH := $(PLATFORM_SECURITY_PATCH)

# Storage
BOARD_USES_METADATA_PARTITION := true
RECOVERY_SDCARD_ON_DATA := true
TW_SKIP_ADDITIONAL_FSTAB := true
OF_SKIP_DECRYPTED_ADOPTED_STORAGE := 1
BOARD_HAS_NO_REAL_SDCARD := true

# Logging
TWRP_INCLUDE_LOGCAT := true
TARGET_USES_LOGD := true

# Device
TARGET_RECOVERY_DEVICE_DIRS := $(DEVICE_PATH)
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab
TARGET_OTA_ASSERT_DEVICE := PD2502,PD2509,mt6993

# GLUTTONY
TW_EXCLUDE_APEX := true
TW_EXTRA_LANGUAGES := true

BOARD_RAMDISK_USE_LZ4 := false
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true
BOARD_INCLUDE_RECOVERY_RAMDISK_IN_VENDOR_BOOT := true

TW_ENABLE_ALL_PARTITION_TOOLS := true

# Device-specific
BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2
